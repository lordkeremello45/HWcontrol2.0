<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="HWControl" Manufacturer="HWControl contributors" Version="$(var.Version)" UpgradeCode="6E0E6A5E-69A0-4B2A-9C89-8F2507A1D890">
    <MajorUpgrade DowngradeErrorMessage="A newer HWControl version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="MainFeature" Title="HWControl" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="BridgeServiceComponent" />
    </Feature>

    <Component Id="BridgeServiceComponent" Directory="INSTALLFOLDER">
      <File Id="BridgeServiceExe" Source="$(var.PackageDir)\bridge-service.exe" KeyPath="yes" />
      <ServiceInstall Id="BridgeServiceInstall" Name="HWControlBridge" DisplayName="HWControl Bridge" Description="HWControl local authenticated bridge service" ErrorControl="normal" Start="auto" Type="ownProcess" Vital="yes" />
      <ServiceControl Id="BridgeServiceControl" Name="HWControlBridge" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="HWControl" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PackageDir)\**">
        <Exclude Files="$(var.PackageDir)\bridge-service.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>

#!/bin/sh
set -eu

APP_DIR="/Applications/HWControl"
PLIST_SRC="$APP_DIR/com.hwcontrol.bridge.plist"
PLIST_DST="/Library/LaunchDaemons/com.hwcontrol.bridge.plist"
KEY_DIR="/Library/Application Support/HWControl"
KEY_FILE="$KEY_DIR/bridge.key"

/bin/mkdir -p "$KEY_DIR"

if [ ! -s "$KEY_FILE" ]; then
  umask 077
  /usr/bin/head -c 32 /dev/urandom | /usr/bin/od -An -tx1 | /usr/bin/tr -d ' \n' > "$KEY_FILE"
fi

/usr/bin/test -s "$KEY_FILE"
/bin/chmod 0600 "$KEY_FILE"

if [ -f "$PLIST_SRC" ]; then
  /bin/mkdir -p "/Library/LaunchDaemons"
  /usr/bin/install -m 0644 "$PLIST_SRC" "$PLIST_DST"
  /usr/sbin/chown root:wheel "$PLIST_DST"
  /usr/bin/plutil -lint "$PLIST_DST" >/dev/null
fi

exit 0

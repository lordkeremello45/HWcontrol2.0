#!/bin/sh
set -eu

APP_DIR="/Applications/HWControl"
PLIST_SRC="$APP_DIR/com.hwcontrol.bridge.plist"
PLIST_DST="/Library/LaunchDaemons/com.hwcontrol.bridge.plist"
KEY_DIR="/Library/Application Support/HWControl"
KEY_FILE="$KEY_DIR/bridge.key"
APP_PLIST="$APP_DIR/HWControl.app/Contents/Info.plist"

/bin/mkdir -p "$KEY_DIR"
if [ ! -s "$KEY_FILE" ]; then
  /usr/bin/openssl rand -hex 32 > "$KEY_FILE"
  /bin/chmod 0644 "$KEY_FILE"
fi

if [ -f "$APP_PLIST" ]; then
  /usr/bin/plutil -replace LSEnvironment.HWCONTROL_KEY -string "$(/bin/cat "$KEY_FILE")" "$APP_PLIST" 2>/dev/null || \
  /usr/bin/plutil -insert LSEnvironment.HWCONTROL_KEY -string "$(/bin/cat "$KEY_FILE")" "$APP_PLIST"
fi

if [ -f "$PLIST_SRC" ]; then
  /bin/mkdir -p "/Library/LaunchDaemons"
  /usr/bin/install -m 644 "$PLIST_SRC" "$PLIST_DST"
  /usr/sbin/chown root:wheel "$PLIST_DST"
  /usr/bin/plutil -lint "$PLIST_DST" >/dev/null
  /bin/launchctl bootout system/com.hwcontrol.bridge >/dev/null 2>&1 || true
  /bin/launchctl bootstrap system "$PLIST_DST"
  /bin/launchctl enable system/com.hwcontrol.bridge
  /bin/launchctl kickstart -k system/com.hwcontrol.bridge
fi

exit 0

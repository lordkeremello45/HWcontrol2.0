#!/bin/sh
set -eu

APP_DIR="/Applications/HWControl"
PLIST_SRC="$APP_DIR/com.hwcontrol.bridge.plist"
PLIST_DST="/Library/LaunchDaemons/com.hwcontrol.bridge.plist"
KEY_DIR="/Library/Application Support/HWControl"
KEY_FILE="$KEY_DIR/bridge.key"
LOG_FILE="/tmp/hwcontrol-postinstall.log"

log() {
  printf '%s %s\n' "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >> "$LOG_FILE"
}

log "postinstall start"

/bin/mkdir -p "$KEY_DIR"
/bin/chmod 0700 "$KEY_DIR"

if [ ! -s "$KEY_FILE" ]; then
  umask 077
  tmp_key="${KEY_FILE}.tmp.$$"
  trap '/bin/rm -f "$tmp_key"' EXIT HUP INT TERM
  /usr/bin/openssl rand -hex 32 > "$tmp_key"
  key_length=$(/usr/bin/wc -c < "$tmp_key")
  key_length=$(printf '%s' "$key_length" | /usr/bin/tr -d '[:space:]')
  /usr/bin/test "$key_length" -eq 64
  /bin/chmod 0600 "$tmp_key"
  /bin/mv -f "$tmp_key" "$KEY_FILE"
  trap - EXIT HUP INT TERM
  log "bridge key created"
else
  log "existing bridge key preserved"
fi

/usr/bin/test -s "$KEY_FILE"

# The launch daemon runs as root, while the desktop app runs as the
# logged-in console user. Keep the key private to that user and root.
CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
  /usr/sbin/chown "$CONSOLE_USER:staff" "$KEY_DIR"
  /bin/chmod 0750 "$KEY_DIR"
  /usr/sbin/chown "$CONSOLE_USER:staff" "$KEY_FILE"
  /bin/chmod 0640 "$KEY_FILE"
else
  /usr/sbin/chown root:wheel "$KEY_FILE"
  /bin/chmod 0600 "$KEY_FILE"
fi

if [ -f "$PLIST_SRC" ]; then
  /bin/mkdir -p "/Library/LaunchDaemons"
  /usr/bin/install -m 0644 "$PLIST_SRC" "$PLIST_DST"
  /usr/bin/plutil -lint "$PLIST_DST" >/dev/null
  log "launch daemon plist installed"
else
  log "launch daemon plist missing: $PLIST_SRC"
  exit 1
fi

log "postinstall complete"
exit 0

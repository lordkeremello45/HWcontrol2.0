#!/bin/sh
set -eu

APP_DIR="/Applications/HWControl"
PLIST_SRC="$APP_DIR/com.hwcontrol.bridge.plist"
PLIST_DST="/Library/LaunchDaemons/com.hwcontrol.bridge.plist"
KEY_DIR="/Library/Application Support/HWControl"
KEY_FILE="$KEY_DIR/bridge.key"

# Installer scripts run as root. Keep the bridge secret outside the signed app bundle.
/bin/mkdir -p "$KEY_DIR"
/usr/sbin/chown root:wheel "$KEY_DIR"
/bin/chmod 0700 "$KEY_DIR"

if [ ! -s "$KEY_FILE" ]; then
  umask 077
  tmp_key="${KEY_FILE}.tmp.$$"
  /usr/bin/head -c 32 /dev/urandom | /usr/bin/od -An -tx1 | /usr/bin/tr -d ' \n' > "$tmp_key"
  /usr/bin/test -s "$tmp_key"
  /bin/chmod 0600 "$tmp_key"
  /usr/sbin/chown root:wheel "$tmp_key"
  /bin/mv -f "$tmp_key" "$KEY_FILE"
fi

/usr/bin/test -s "$KEY_FILE"
/bin/chmod 0600 "$KEY_FILE"
/usr/sbin/chown root:wheel "$KEY_FILE"

if [ -f "$PLIST_SRC" ]; then
  /bin/mkdir -p "/Library/LaunchDaemons"
  /usr/bin/install -o root -g wheel -m 0644 "$PLIST_SRC" "$PLIST_DST"
  /usr/bin/plutil -lint "$PLIST_DST" >/dev/null
fi

exit 0

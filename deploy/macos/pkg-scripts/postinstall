#!/bin/sh

APP_DIR="/Applications/HWControl"
PLIST_SRC="$APP_DIR/com.hwcontrol.bridge.plist"
PLIST_DST="/Library/LaunchDaemons/com.hwcontrol.bridge.plist"

# Package installation must not fail just because launchd setup is unavailable
# in a CI environment or before a valid HWCONTROL_KEY has been configured.
if [ -f "$PLIST_SRC" ]; then
  /bin/mkdir -p "/Library/LaunchDaemons" 2>/dev/null || true
  /usr/bin/install -m 644 "$PLIST_SRC" "$PLIST_DST" 2>/dev/null || true
  /usr/sbin/chown root:wheel "$PLIST_DST" 2>/dev/null || true
  /usr/bin/plutil -lint "$PLIST_DST" >/dev/null 2>&1 || true
fi

exit 0

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hwcontrol.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/HWControl/bridge-service</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HWCONTROL_KEY_FILE</key>
        <string>/Library/Application Support/HWControl/bridge.key</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>

# Optional third-party dependency discovery for HWVision.
# No dependency is downloaded or executed during configure. System/package-manager
# installations are discovered explicitly; CPU-only builds remain deterministic.

option(HWVISION_ENABLE_OPTIONAL_DEPENDENCIES "Discover optional HWVision libraries" ON)
option(HWVISION_REQUIRE_OPTIONAL_DEPENDENCIES "Fail configure if an enabled optional library is missing" OFF)
option(HWVISION_ENABLE_FFMPEG "Enable FFmpeg development-package discovery" ON)
option(HWVISION_ENABLE_OPENCOLORIO "Enable OpenColorIO discovery" ON)
option(HWVISION_ENABLE_OPENEXR "Enable OpenEXR discovery (test/reference assets)" ON)
option(HWVISION_ENABLE_VULKAN "Enable Vulkan SDK discovery" ON)

add_library(hwvision_optional_dependencies INTERFACE)
add_library(HWVision::OptionalDependencies ALIAS hwvision_optional_dependencies)

if(NOT HWVISION_ENABLE_OPTIONAL_DEPENDENCIES)
  message(STATUS "HWVision optional dependencies: disabled")
  return()
endif()

set(_hwvision_missing "")
find_package(PkgConfig QUIET)

if(HWVISION_ENABLE_FFMPEG)
  if(PkgConfig_FOUND)
    pkg_check_modules(HWVISION_FFMPEG QUIET IMPORTED_TARGET
      libavcodec libavformat libavutil libswscale)
  endif()
  if(TARGET PkgConfig::HWVISION_FFMPEG)
    target_link_libraries(hwvision_optional_dependencies INTERFACE PkgConfig::HWVISION_FFMPEG)
    target_compile_definitions(hwvision_optional_dependencies INTERFACE HWVISION_HAS_FFMPEG=1)
    message(STATUS "HWVision: FFmpeg development libraries discovered")
  else()
    list(APPEND _hwvision_missing "FFmpeg (libavcodec/libavformat/libavutil/libswscale via pkg-config)")
    message(STATUS "HWVision: FFmpeg not found; decoder adapter unavailable")
  endif()
endif()

if(HWVISION_ENABLE_OPENCOLORIO)
  find_package(OpenColorIO CONFIG QUIET)
  if(TARGET OpenColorIO::OpenColorIO)
    target_link_libraries(hwvision_optional_dependencies INTERFACE OpenColorIO::OpenColorIO)
    target_compile_definitions(hwvision_optional_dependencies INTERFACE HWVISION_HAS_OPENCOLORIO=1)
    message(STATUS "HWVision: OpenColorIO discovered")
  else()
    list(APPEND _hwvision_missing "OpenColorIO")
    message(STATUS "HWVision: OpenColorIO not found; external color-management adapter unavailable")
  endif()
endif()

if(HWVISION_ENABLE_OPENEXR)
  find_package(OpenEXR CONFIG QUIET)
  if(TARGET OpenEXR::OpenEXR)
    target_link_libraries(hwvision_optional_dependencies INTERFACE OpenEXR::OpenEXR)
    target_compile_definitions(hwvision_optional_dependencies INTERFACE HWVISION_HAS_OPENEXR=1)
    message(STATUS "HWVision: OpenEXR discovered")
  else()
    list(APPEND _hwvision_missing "OpenEXR")
    message(STATUS "HWVision: OpenEXR not found; EXR reference-asset adapter unavailable")
  endif()
endif()

if(HWVISION_ENABLE_VULKAN)
  find_package(Vulkan QUIET)
  if(Vulkan_FOUND)
    target_link_libraries(hwvision_optional_dependencies INTERFACE Vulkan::Vulkan)
    target_compile_definitions(hwvision_optional_dependencies INTERFACE HWVISION_HAS_VULKAN=1)
    message(STATUS "HWVision: Vulkan SDK/loader discovered (presentation adapter still requires implementation)")
  else()
    list(APPEND _hwvision_missing "Vulkan")
    message(STATUS "HWVision: Vulkan not found; Vulkan backend unavailable")
  endif()
endif()

if(WIN32)
  # Link only the documented platform SDK import libraries. This does not claim
  # that a DXGI/D3D12 presentation adapter exists yet.
  target_link_libraries(hwvision_optional_dependencies INTERFACE dxgi d3d12)
  target_compile_definitions(hwvision_optional_dependencies INTERFACE HWVISION_PLATFORM_WINDOWS=1)
elseif(APPLE)
  find_library(HWVISION_METAL_FRAMEWORK Metal)
  find_library(HWVISION_FOUNDATION_FRAMEWORK Foundation)
  if(HWVISION_METAL_FRAMEWORK AND HWVISION_FOUNDATION_FRAMEWORK)
    target_link_libraries(hwvision_optional_dependencies INTERFACE
      "${HWVISION_METAL_FRAMEWORK}" "${HWVISION_FOUNDATION_FRAMEWORK}")
    target_compile_definitions(hwvision_optional_dependencies INTERFACE HWVISION_PLATFORM_APPLE=1)
    message(STATUS "HWVision: Metal framework discovered (EDR adapter still requires implementation)")
  endif()
elseif(UNIX)
  target_compile_definitions(hwvision_optional_dependencies INTERFACE HWVISION_PLATFORM_LINUX=1)
endif()

if(HWVISION_REQUIRE_OPTIONAL_DEPENDENCIES AND _hwvision_missing)
  list(JOIN _hwvision_missing ", " _hwvision_missing_text)
  message(FATAL_ERROR "Required HWVision dependencies were not found: ${_hwvision_missing_text}")
endif()

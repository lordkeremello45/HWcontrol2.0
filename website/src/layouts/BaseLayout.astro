---
const {
  title = "HWcontrol2.0 — Open-Source Hardware Monitoring for Windows, macOS and Linux",
  description = "HWcontrol2.0 is an open-source beta desktop app for hardware monitoring, diagnostics and capability-gated fan control on Windows, macOS and Linux.",
  path = "/"
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const siteBase = new URL(base, "https://lordkeremello45.github.io");
const canonical = new URL(path === "/" ? "" : path.replace(/^\/+/, ""), siteBase).toString();
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "HWcontrol2.0",
  url: siteBase.href,
  description: "Official downloads and documentation for the open-source HWcontrol2.0 desktop hardware monitoring application.",
  publisher: {
    "@type": "Organization",
    name: "HWcontrol Team",
    url: "https://lordkeremello45.github.io/HWcontrol-Team.github.io/"
  }
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0b1017" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com; img-src 'self' data: https://cdn.simpleicons.org; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="HWcontrol2.0" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <header class="nav shell">
      <a class="brand" href={base} aria-label="HWcontrol2.0 home">
        <span class="brand-mark">H</span><span>HWControl <b>2.0</b></span>
      </a>
      <nav aria-label="Primary">
        <a href={`${base}#features`}>Features</a>
        <a href={`${base}#security`}>Security</a>
        <a href={`${base}#download`}>Download</a>
        <a href={`${base}privacy/`}>Privacy</a>
        <a href="https://github.com/lordkeremello45/HWcontrol2.0" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="footer shell">
      <div class="brand"><span class="brand-mark">H</span><span>HWControl <b>2.0</b></span></div>
      <span>GPL-3.0 · Website source: AGPL-3.0-only</span>
      <a href="https://github.com/lordkeremello45/HWcontrol2.0/releases" target="_blank" rel="noopener noreferrer">All releases ↗</a>
    </footer>
  </body>
</html>

---
const {
  title = "HWControl 2.0 — Hardware Control, Simplified",
  description = "Open-source hardware monitoring and control for Windows, macOS and Linux.",
  path = "/"
} = Astro.props;
const canonical = `https://lordkeremello45.github.io/HWcontrol2.0${path === "/" ? "/" : path}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1017" />
    <meta name="robots" content="index,follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="HWControl 2.0" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav shell">
      <a class="brand" href={import.meta.env.BASE_URL} aria-label="HWControl 2.0 home">
        <span class="brand-mark">H</span><span>HWControl <b>2.0</b></span>
      </a>
      <nav aria-label="Primary">
        <a href={import.meta.env.BASE_URL + "#features"}>Features</a>
        <a href={import.meta.env.BASE_URL + "#security"}>Security</a>
        <a href={import.meta.env.BASE_URL + "#download"}>Download</a>
        <a href="https://github.com/lordkeremello45/HWcontrol2.0" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="footer shell">
      <div class="brand"><span class="brand-mark">H</span><span>HWControl <b>2.0</b></span></div>
      <span>GPL-3.0 · Website source: AGPL-3.0-only</span>
      <a href="https://github.com/lordkeremello45/HWcontrol2.0/releases" target="_blank" rel="noopener noreferrer">All releases ↗</a>
    </footer>
  </body>
</html>
